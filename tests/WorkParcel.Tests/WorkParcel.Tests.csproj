<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <DisableWindowsAppSDKAutoInitialize>true</DisableWindowsAppSDKAutoInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the test process independent from the app executable. These are
         the same production source files used by WorkParcel. -->
    <Compile Include="..\..\src\WorkParcel.App\Models\WorkModels.cs" Link="Models\WorkModels.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\AppDataPaths.cs" Link="Services\AppDataPaths.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\AppLogger.cs" Link="Services\AppLogger.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\ExternalLaunchService.cs" Link="Services\ExternalLaunchService.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\SqliteDatabase.cs" Link="Services\SqliteDatabase.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\WorkspaceRepository.cs" Link="Services\WorkspaceRepository.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\WorkspaceStore.cs" Link="Services\WorkspaceStore.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\ParcelQueries.cs" Link="Services\ParcelQueries.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\ParcelItemServices.cs" Link="Services\ParcelItemServices.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\WindowsWorkspaceServices.cs" Link="Services\WindowsWorkspaceServices.cs" />
    <Compile Include="..\..\src\WorkParcel.App\Services\ParcelItemQueries.cs" Link="Services\ParcelItemQueries.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
