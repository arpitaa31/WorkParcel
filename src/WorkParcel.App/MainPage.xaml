<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkParcel_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <NavigationView x:Name="Navigation" IsSettingsVisible="False" IsBackEnabled="False" PaneDisplayMode="Auto" SelectionChanged="Navigation_SelectionChanged" Background="{ThemeResource AppBackgroundBrush}">
            <NavigationView.PaneHeader>
                <StackPanel Padding="14,18,14,16">
                    <TextBlock Text="WORKPARCEL" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock Text="Save a setup. Open it when you return." FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="PARCELS" Tag="parcels"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="TODAY" Tag="today"><NavigationViewItem.Icon><SymbolIcon Symbol="CalendarDay" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="ARCHIVE" Tag="archive"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="SETTINGS" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Frame x:Name="ContentFrame" Padding="0" />
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Page>
