<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host only needs the versioned native-messaging envelope and
         framing. Keep the bridge independent from the app/database assembly
         so it can be launched by Chrome/Edge with a minimal trust surface. -->
    <Compile Include="..\WorkParcel.Core\BrowserProtocol.cs" Link="BrowserProtocol.cs" />
  </ItemGroup>
</Project>
