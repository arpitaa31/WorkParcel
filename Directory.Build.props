<Project>
  <PropertyGroup>
    <!-- Single release-version source shared by the application, host, and installer build. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.1.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.1.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company></Company>
    <AssemblyCompany></AssemblyCompany>
    <Product>WorkParcel</Product>
    <Description>Save a setup. Open it when you return.</Description>
    <Title>WorkParcel</Title>
  </PropertyGroup>
</Project>
