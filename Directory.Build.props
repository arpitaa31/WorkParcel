<Project>
  <PropertyGroup>
    <!-- Single release-version source shared by the application and installer build. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <ReleaseVersion>0.2.0-beta.3</ReleaseVersion>
    <Version Condition="'$(Version)' == ''">$(ReleaseVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.2.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.2.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(ReleaseVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Arpitaa</Authors>
    <Company>Arpitaa</Company>
    <AssemblyCompany>Arpitaa</AssemblyCompany>
    <Product>WorkParcel</Product>
    <Description>Save the apps, files, folders and web links connected to a task, pack the setup away and reopen it later.</Description>
    <Copyright>Copyright (c) Arpitaa</Copyright>
    <Title>WorkParcel</Title>
  </PropertyGroup>
</Project>
